DATABASE_URL=postgresql://user:password@host/dbname
SECRET_KEY=put-a-long-random-string-here

# Voice memos. Without OPENAI_API_KEY the app runs in stub mode: the record
# button works end to end and returns a canned example, so nothing breaks.
OPENAI_API_KEY=
# Optional overrides:
# AI_PROVIDER=stub          # force stub mode even when a key is present
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# OPENAI_PARSE_MODEL=gpt-5.6
